{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.schema.json",
  "title": "Kids Word Story Video v2",
  "type": "object",
  "required": ["$schema", "meta", "visualBible", "scenes"],
  "properties": {
    "$schema": {"const": "story.schema.json"},
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion", "category", "series", "width", "height", "imageWidth", "imageHeight",
        "fps", "imageNormalization", "imageAspectTolerancePct", "ttsProvider", "voice", "rate",
        "targetPauseSec", "targetVisualDurationSec", "introTailSec", "durationTarget",
        "introTitle", "pauseTargets", "theme"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "width": {"const": 1280},
        "height": {"const": 720},
        "imageWidth": {"const": 1280},
        "imageHeight": {"const": 720},
        "fps": {"const": 20},
        "imageNormalization": {"const": "stable-lanczos"},
        "imageAspectTolerancePct": {"const": 1.0},
        "ttsProvider": {"enum": ["edge", "azure"]},
        "voice": {"type": "string", "minLength": 1},
        "rate": {"type": "string", "pattern": "^[+-]?[0-9]+%$"},
        "targetPauseSec": {"type": "number", "minimum": 0},
        "targetVisualDurationSec": {"type": "number", "minimum": 0.05},
        "introTailSec": {"type": "number", "minimum": 0},
        "durationTarget": {
          "type": "object",
          "required": [
            "targetSec", "idealMinSec", "idealMaxSec", "acceptableMinSec",
            "acceptableMaxSec", "maxCreativeAdjustments"
          ],
          "properties": {
            "targetSec": {"type": "number", "minimum": 1},
            "idealMinSec": {"type": "number", "minimum": 1},
            "idealMaxSec": {"type": "number", "minimum": 1},
            "acceptableMinSec": {"type": "number", "minimum": 1},
            "acceptableMaxSec": {"type": "number", "minimum": 1},
            "maxCreativeAdjustments": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "introTitle": {"type": "string", "minLength": 1},
        "pauseTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z]+$"}},
        "theme": {"type": "object"}
      }
    },
    "visualBible": {
      "type": "object",
      "required": ["stylePrompt", "palette", "characters", "referenceImage"],
      "properties": {
        "stylePrompt": {"type": "string", "minLength": 1},
        "palette": {"type": "string", "minLength": 1},
        "referenceImage": {"type": "string", "minLength": 1},
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "role", "appearance", "mustKeep"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "appearance": {"type": "string", "minLength": 1},
              "mustKeep": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "zh", "image", "imagePrompt", "characterIds", "visualRequirements", "targetMarkers"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "zh": {"type": "string", "minLength": 1},
          "image": {"type": "string", "minLength": 1},
          "imagePrompt": {"type": "string", "pattern": "16:9"},
          "characterIds": {"type": "array", "items": {"type": "string"}},
          "visualRequirements": {
            "type": "object",
            "required": ["mustShow", "mustNotShow", "action", "continuity"],
            "properties": {
              "mustShow": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "mustNotShow": {"type": "array", "items": {"type": "string"}},
              "action": {"type": "string", "minLength": 1},
              "continuity": {"type": "array", "items": {"type": "string"}},
              "criticalAction": {
                "type": "object",
                "required": [
                  "subject", "bodyPartOrTool", "object", "contact", "relativePosition",
                  "direction", "result", "forbiddenAlternatives"
                ],
                "properties": {
                  "subject": {"type": "string", "minLength": 1},
                  "bodyPartOrTool": {"type": "string", "minLength": 1},
                  "object": {"type": "string", "minLength": 1},
                  "contact": {"type": "string", "minLength": 1},
                  "relativePosition": {"type": "string", "minLength": 1},
                  "direction": {"type": "string", "minLength": 1},
                  "result": {"type": "string", "minLength": 1},
                  "forbiddenAlternatives": {"type": "array", "items": {"type": "string", "minLength": 1}}
                },
                "additionalProperties": false
              }
            }
          },
          "imageGeneration": {
            "type": "object",
            "required": ["dependsOn", "serialReasons"],
            "properties": {
              "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "serialReasons": {
                "type": "array",
                "uniqueItems": true,
                "items": {"enum": ["continuous-action", "prop-state", "previous-image-reference", "manual"]}
              }
            },
            "additionalProperties": false
          },
          "targetMarkers": {"type": "object"},
          "audio": {"type": "string", "minLength": 1},
          "audioDurationSec": {"type": "number", "exclusiveMinimum": 0},
          "visualTailSec": {"type": "number", "minimum": 0},
          "targetHighlights": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["word", "displayWord", "start", "spokenDurationSec", "visualDurationSec"],
              "properties": {
                "word": {"type": "string", "pattern": "^[a-z]+$"},
                "displayWord": {"type": "string", "pattern": "^[A-Za-z]+$"},
                "start": {"type": "number", "minimum": 0},
                "spokenDurationSec": {"type": "number", "exclusiveMinimum": 0},
                "visualDurationSec": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
